[Unit]
Description=GitHub Webhook — CS50x Anzali Auto-Deploy
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/var/www/cs50hub
# Secret را در این فایل قرار دهید (chmod 600) — هرگز در git commit نشود:
#   /etc/cs50hub/webhook.env  →  WEBHOOK_SECRET=...
EnvironmentFile=-/etc/cs50hub/webhook.env
ExecStart=/var/www/cs50hub/venv/bin/python /var/www/cs50hub/deploy/webhook.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
