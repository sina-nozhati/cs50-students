# نمونه‌ی متغیرهای محیطی — این فایل را به .env کپی کنید و مقادیر واقعی بگذارید.
# هرگز فایل .env واقعی را commit نکنید.

# کلید امنیتی — در production یک رشته‌ی طولانی تصادفی بگذارید (مثلاً openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string

# رمز کاربر ادمین پیش‌فرض
ADMIN_PASSWORD=cs50-anzali-admin

# آدرس دیتابیس — پیش‌فرض SQLite محلی. برای PostgreSQL:
# SQLALCHEMY_DATABASE_URI=postgresql://user:pass@localhost/cs50hub
# DATABASE_URL=postgresql://user:pass@localhost/cs50hub

# سطح لاگ
LOG_LEVEL=INFO
