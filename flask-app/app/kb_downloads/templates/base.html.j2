{% if copy_js %}<script>
document.querySelectorAll('.codeblock').forEach(function(b){var t=b.querySelector('pre');var k=document.createElement('button');k.className='copy';k.type='button';k.textContent='کپی';k.setAttribute('aria-label','کپی کد');k.onclick=function(){navigator.clipboard.writeText(t.innerText).then(function(){k.textContent='کپی شد';setTimeout(function(){k.textContent='کپی'},1500)})};b.appendChild(k)});
