      "spaced_recall": "min(1, rolling_recall_rate/0.8)",
      "pset": "(checklist_complete*0.5) + (submission_exists*0.5)"
    },
    "note_fa": "زمان صرف‌شده و تعداد کلیک در درصد پیشرفت اثری ندارند."
