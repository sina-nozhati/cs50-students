{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anzali.local/kb/schemas/manifest.schema.json",
  "title": "Package manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "files",
    "counts",
    "generated_at"
  ],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {},
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
