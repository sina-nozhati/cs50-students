      "true_false": "value equality",
      "token_tap": "filled tokens in blank order equal expected_answer (list) exactly",
      "spot_bug": "bug_line_index equality (0-based)",
      "challenge_parsons": "submitted ids equal correct_order; lines with identical text are interchangeable (see grading_note)",
      "find_the_bug/short_answer": "not auto-graded: store text, show key_points_fa after submit, mentor or self review"
