      ],
      "reading": {
        "text_fa": "`argv[0]` نام برنامه است و آخرین آرگومان `argv[argc - 1]` است. ویدئوی کوتاه Command-Line Arguments (۲۰۱۷) تأکید می‌کند همهٔ آرگومان‌ها رشته‌اند: `1024` در `./greedy 1024 CS50` رشتهٔ \"1024\" است، نه عدد int. دسترسی به argv بیرون از مرز ممکن است segmentation fault بدهد.",
        "note_id": "w02-n16",
        "origin": "translated-rewritten",
        "link": "/kb/d/w02-n16"
      },
      "example": {
        "kind": "official",
        "origin": "official",
        "example_key": "greet2",
        "lang": "c",
        "content": "// Prints command-line arguments\n\n#include <cs50.h>\n#include <stdio.h>\n\nint main(int argc, string argv[])\n{\n    for (int i = 0; i < argc; i++)\n    {\n        printf(\"%s\\n\", argv[i]);\n    }\n}",
        "source_ref": "src-notes-2#command-line-arguments",
        "explain_fa": "چاپ همهٔ آرگومان‌ها."
      },
      "check": {
