  "required_choice": {
    "note_fa": "طبق صفحهٔ رسمی پرابلم‌ست ۳: Sort و Plurality تحویل شوند و یکی از Runoff یا Tideman. Runoff برای کسانی است که کم‌وبیش احساس راحتی می‌کنند و Tideman برای کسانی که «خیلی، خیلی، خیلی» راحت‌اند. طبق همان صفحه، اگر هر دو تحویل شود نمرهٔ بالاتر ثبت می‌شود و Tideman اختیاری ولی چالشی است. تمرین‌های Recursive atoi، Average High Temperatures، Max و Snackbar اختیاری‌اند و تحویل ندارند.",
    "groups": [
      {
        "required": [
          "w03-ps-sort"
        ],
        "submit": true
      },
      {
        "required": [
          "w03-ps-plurality"
        ],
        "submit": true
      },
      {
        "one_of": [
          "w03-ps-runoff",
          "w03-ps-tideman"
        ],
        "submit": true,
        "choice_group": "runoff-tideman",
        "if_both": "higher_score_counts",
        "if_both_origin": "official",
        "if_both_source_ref": "src-pset-3#what-to-do"
      }
    ],
    "optional_practice": [
      "w03-pr-atoi",
      "w03-pr-temps",
      "w03-pr-max",
      "w03-pr-snackbar"
    ],
    "source_ref": "src-pset-3#what-to-do"
  },
