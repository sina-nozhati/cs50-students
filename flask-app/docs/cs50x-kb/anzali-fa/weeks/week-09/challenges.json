          "index": 3,
          "text": "db = SQL(\"sqlite:///shows.db\")"
        },
        {
          "index": 4,
          "text": "@app.route(\"/search\")"
        },
        {
          "index": 5,
          "text": "def search():"
        },
        {
          "index": 6,
          "text": "    q = request.args.get(\"q\")"
        },
        {
          "index": 7,
          "text": "    shows = db.execute(\"SELECT * FROM shows WHERE title LIKE ?\", \"%\" + q + \"%\")"
